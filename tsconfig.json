{
	"extends": "@tsconfig/node20/tsconfig.json",
	"compilerOptions": {
		"customConditions": [
			"node",
			"jest"
		],
		"module": "ES2022",
		"moduleResolution": "Bundler",
		"noImplicitOverride": true,
		"lib": ["ES2022", "DOM"],
		"types": ["node", "jest"]
	},
	"include": [
		"src/**/*.ts",
		"tests/**/*.spec.ts"
	],
	"exclude": [
		"node_modules"
	]
}
